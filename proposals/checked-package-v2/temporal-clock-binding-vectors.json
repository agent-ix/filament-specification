    "capture_patch": {"file": "fsl-package/src/emit/tests/hyper_clause.rs", "function": "a_finite_trace_set_hyperproperty_emits_its_finite_domain", "insert_after": "the emit_checked_with_temporal_selections(...).expect(\"the finite clause emits\") call", "rust": "if let Some(path) = std::env::var_os(\"TCB_FIXTURE_OUT\") { std::fs::write(path, emission.package.bytes()).expect(\"write complete checked-package fixture\"); }", "command": "TCB_FIXTURE_OUT=/tmp/tcb-finite-hyper.json cargo test --locked -p fsl-package --lib -- emit::tests::hyper_clause::a_finite_trace_set_hyperproperty_emits_its_finite_domain -- --exact"},
    "unit_source": "language \"ix:native\" edition \"1-draft\";\nprofile v = \"filament.value.complete/v1\";\nprofile t = \"filament.temporal.event-position.false-extension/v1\";\nrecord Obs { inp: Int[0, 3]; res: Int[0, 3]; }\nhyper Det using t over t in Obs bounded 3 forall trace a forall trace b { (a.inp = b.inp) implies (a.res = b.res) }",
