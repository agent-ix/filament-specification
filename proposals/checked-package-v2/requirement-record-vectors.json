{
  "version": "filament.checked-package-v2-requirement-record-vectors/v1",
  "test_case": "TC-2053",
  "requirement": "FR-825",
  "note": "Each case is a reader-input recipe. Resolve source names, node roles and source occurrences against the checked graph, then construct a complete package as FR-825 specifies. Node IDs are not fixed across packages.",
  "positive": [
    {
      "id": "RRV-01-bare-boolean-parameter-guard",
      "ac": ["FR-825-AC-6"],
      "source": "function f using v(p: Boolean, x: Int[0, 9]): Int[0, 10] pure { if p then x + 1 else x + 1 }",
      "owner": {"declaration": "f", "role": "function"},
      "guard": {"name": "p", "role": "value/parameter", "semantic_type": "scalar_type/boolean", "reachability": "owner body root"},
      "guard_read": {"role": "expression", "read_as": "if condition"},
      "application": {"source": "x + 1", "role": "expression", "occurrences": [0, 1]},
      "path_condition": [
        {"application_occurrence": 0, "guard": "p", "guard_read_occurrence": 0, "holds": true},
        {"application_occurrence": 1, "guard": "p", "guard_read_occurrence": 0, "holds": false}
      ],
      "extent_roots": ["p", "x"],
      "expected": {"admitted": true, "record_count": 2, "identity_includes": ["guard node", "guard read occurrence", "holds"]}
    }
  ],
  "reader_refusals": [
    {
      "id": "RRV-02-non-boolean-value-guard",
      "ac": ["FR-825-AC-7"],
      "base": "RRV-01-bare-boolean-parameter-guard",
      "mutation": {
        "application_occurrence": 0,
        "replace_guard": "p",
        "with": {"name": "x", "role": "value/parameter", "semantic_type": "scalar_type/integer", "reachability": "owner body root"},
        "guard_read_occurrence": {"node": "x", "source_occurrence": "its read in x + 1"},
        "rebuild": ["record node identity", "requirement_items references", "all references to the changed record"]
      },
      "expected": {"code": "invalid_package", "cause": "invalid-value", "pointer": "body/members/5/value/members/0"}
    }
  ]
}
