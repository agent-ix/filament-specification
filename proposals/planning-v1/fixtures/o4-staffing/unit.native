language "ix:native" edition "1-draft";
profile p = "filament.model.complete/v1";
model M = "example/plan-staffing";
function staff using p(c: M::Crew, s: M::Station): Integer pure { if s = M::Station::process then c.process else if s = M::Station::pack then c.pack else c.ship }
pre CanMove using p on M::Crew::move { from != to and staff(self, from) > 1 }
post Move using p on M::Crew::move { self.process = pre(self.process) + (if to = M::Station::process then 1 else 0) - (if from = M::Station::process then 1 else 0) and self.pack = pre(self.pack) + (if to = M::Station::pack then 1 else 0) - (if from = M::Station::pack then 1 else 0) and self.ship = pre(self.ship) + (if to = M::Station::ship then 1 else 0) - (if from = M::Station::ship then 1 else 0) }
invariant Staffed using p on M::Crew at current { self.process >= 1 and self.pack >= 1 and self.ship >= 1 and self.process + self.pack + self.ship = 8 }
type Lengths = Int[0, 3];
synthesis Reach using p grammar M::Crew domain Lengths maximize min(10 * Reach.final.process, 6 * Reach.final.pack, 10 * Reach.final.ship) satisfies { true };
