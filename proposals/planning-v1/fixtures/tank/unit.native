language "ix:native" edition "1-draft";
profile p = "filament.temporal.infinite-trace/v1";
hybrid Tank using p {
  initial { mode Fill when { h = 0 }; }
  mode Fill invariant { h <= 10 } flow { h' = 1; }
    transition to Drain when { h >= 8 } reset { h = h };
  mode Drain invariant { h >= 0 } flow { h' = -2; }
}
type Lengths = Int[0, 1];
synthesis Reach using p grammar Tank domain Lengths satisfies { Reach.final.mode = Tank::Mode::Drain };
