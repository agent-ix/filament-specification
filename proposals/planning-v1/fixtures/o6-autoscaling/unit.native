language "ix:native" edition "1-draft";
profile p = "filament.model.complete/v1";
model M = "example/plan-autoscaling";
type Cost = Decimal[0, 100000; 0, 4; exact];
type Load = Int[0, 9];
function load using p(h: Integer): Load pure { if h = 0 then 2 else if h = 1 then 2 else if h = 2 then 5 else 3 }
pre CanSet using p on M::Cluster::set { self.hour < 4 }
post SetReplicas using p on M::Cluster::set { self.hour = pre(self.hour) + 1 and self.replicas = r }
invariant Capacity using p on M::Cluster at current { self.hour = 0 or convert<Cost>(self.replicas) >= convert<Cost>(load(self.hour - 1)) * 1.2 }
invariant MinimumReplicas using p on M::Cluster at current { self.replicas >= 3 }
type Lengths = Int[0, 4];
synthesis Reach using p grammar M::Cluster domain Lengths minimize sum<Cost>(s in Reach.steps : convert<Cost>(s.arguments.r) * 0.05) satisfies { Reach.final.hour = 4 };
