language "ix:native" edition "1-draft";
profile p = "filament.model.complete/v1";
profile t = "filament.temporal.complete/v1";
model M = "example/plan-production";
dimension Time;
unit s : Time = rational(1, 1);
unit min : Time = rational(60, 1) * s;
time M tick M::Shop::tick period 10 unit min;
pre CanStart using p on M::Shop::start { (if j = M::Job::A then self.aOn else self.bOn) = M::Assignment::waiting and self.aOn != (if m = M::Machine::M1 then M::Assignment::M1 else M::Assignment::M2) and self.bOn != (if m = M::Machine::M1 then M::Assignment::M1 else M::Assignment::M2) }
post Start using p on M::Shop::start { self.aOn = (if j = M::Job::A then (if m = M::Machine::M1 then M::Assignment::M1 else M::Assignment::M2) else pre(self.aOn)) and self.bOn = (if j = M::Job::B then (if m = M::Machine::M1 then M::Assignment::M1 else M::Assignment::M2) else pre(self.bOn)) }
pre CanTick using p on M::Shop::tick { self.tick < 10 }
post Tick using p on M::Shop::tick { self.tick = pre(self.tick) + 1 and self.aRemaining = (if pre(self.aOn) = M::Assignment::M1 or pre(self.aOn) = M::Assignment::M2 then pre(self.aRemaining) - 1 else pre(self.aRemaining)) and self.bRemaining = (if pre(self.bOn) = M::Assignment::M1 or pre(self.bOn) = M::Assignment::M2 then pre(self.bRemaining) - 1 else pre(self.bRemaining)) and self.aOn = (if self.aRemaining = 0 then M::Assignment::finished else pre(self.aOn)) and self.bOn = (if self.bRemaining = 0 then M::Assignment::finished else pre(self.bOn)) }
invariant NoWorkInMaintenance using p on M::Shop at current { not ((self.tick = 2 or self.tick = 3) and (self.aOn = M::Assignment::M2 or self.bOn = M::Assignment::M2)) }
type Lengths = Int[0, 10];
synthesis Reach using t grammar M::Shop domain Lengths minimize Reach.elapsed satisfies { Reach.final.aOn = M::Assignment::finished and Reach.final.bOn = M::Assignment::finished };
