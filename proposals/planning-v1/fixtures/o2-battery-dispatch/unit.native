language "ix:native" edition "1-draft";
profile p = "filament.model.complete/v1";
profile inf = "filament.temporal.infinite-trace/v1";
model M = "example/plan-battery";
pre CanCharge using p on M::Battery::charge { self.hour < 4 }
post Charge using p on M::Battery::charge { self.hour = pre(self.hour) + 1 and self.soc = pre(self.soc) + 0.25 and self.draw = 2 and self.previousDraw = pre(self.draw) }
pre CanIdle using p on M::Battery::idle { self.hour < 4 }
post Idle using p on M::Battery::idle { self.hour = pre(self.hour) + 1 and self.draw = 1 and self.previousDraw = pre(self.draw) }
pre CanDischarge using p on M::Battery::discharge { self.hour < 4 }
post Discharge using p on M::Battery::discharge { self.hour = pre(self.hour) + 1 and self.soc = pre(self.soc) - 0.25 and self.draw = 0 and self.previousDraw = pre(self.draw) }
invariant SocFloor using p on M::Battery at current { self.soc >= 0.20 }
type Lengths = Int[0, 4];
type Cost = Decimal[0, 100000; 0, 4; exact];
temporal Ramp using inf over (b: M::Battery) clock "model-steps" on origin { always holds(abs(b.draw - b.previousDraw) <= 1) }
synthesis Reach using p grammar M::Battery domain Lengths minimize sum<Cost>(s in Reach.steps : (if s.before.hour < 2 then 0.10 else 0.40) * convert<Cost>(s.after.draw)) satisfies { Reach.final.hour = 4 };
